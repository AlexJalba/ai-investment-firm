# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Models (cost-aware routing) ────────────────────────────────────────────────
# Fast / cheap model for research summarization and execution
RESEARCH_MODEL=claude-haiku-4-5-20251001
# Capable model for portfolio decisions
PM_MODEL=claude-sonnet-4-6
# Premium model reserved for Risk Committee deliberation
RISK_MODEL=claude-sonnet-4-6

# ── Portfolio ──────────────────────────────────────────────────────────────────
STARTING_CAPITAL=1000000.0
BENCHMARK_TICKER=SPY

# ── Risk thresholds (HITL triggers above these) ────────────────────────────────
MAX_SINGLE_POSITION_PCT=0.10    # 10% of portfolio
MAX_SECTOR_CONCENTRATION=0.30   # 30% in one sector
DAILY_LOSS_LIMIT_PCT=0.02       # 2% daily drawdown triggers halt
TRADE_NOTIONAL_HITL_THRESHOLD=50000.0  # trades > $50k need human approval

# ── Execution simulation ───────────────────────────────────────────────────────
SLIPPAGE_BPS=5        # basis points
COMMISSION_PER_SHARE=0.005  # USD per share

# ── RAG ────────────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma

# ── Observability ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./data/audit.jsonl
OTLP_ENDPOINT=   # optional — set to e.g. http://localhost:4317 to export spans

# ── Reporting ──────────────────────────────────────────────────────────────────
REPORTS_DIR=./data/reports
